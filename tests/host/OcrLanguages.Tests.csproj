    <Compile Include="..\..\src\Vellum\Services\ExportTargets.cs" Link="ExportTargets.cs" />
    <Compile Include="..\..\src\Vellum\Services\Workflows.cs" Link="Workflows.cs" />
    <!-- Everything in Services/Conversion but OfficeAutomation.cs, the helper that needs Office itself. -->
